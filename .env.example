BOT_TOKEN=123456789:AAПримерТокенаОтBotFather
GEMINI_API_KEY=вставь_ключ_из_Google_AI_Studio
# Несколько ключей из РАЗНЫХ проектов (через запятую) удваивают лимит:
# GEMINI_API_KEYS=ключ_из_проекта1,ключ_из_проекта2
PUBLIC_URL=
WEBHOOK_SECRET=придумай_длинную_случайную_строку
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
ALLOWED_USERS=
MAX_HISTORY_MESSAGES=20
AI_MAX_RETRIES=3
# Ожидание минутного лимита: сколько раз повторить и максимум секунд на попытку.
AI_RATE_LIMIT_RETRIES=4
AI_RATE_LIMIT_MAX_WAIT=60
# Максимальная длина ответа в токенах (меньше — реже лимит по токенам).
AI_MAX_OUTPUT_TOKENS=2048

# Если провайдер блокирует Telegram и ты пользуешься VPN/прокси —
# раскомментируй и укажи адрес локального прокси:
# HTTPS_PROXY=http://127.0.0.1:8080

# --- Groq (резервный провайдер, необязательно) ---
# Бесплатный ключ: https://console.groq.com/keys
# Если Gemini исчерпал лимит, бот автоматически спросит модель у Groq.
# Для любого OpenAI-совместимого сервиса: GROQ_BASE_URL.
GROQ_API_KEY=
# Модель подстраховки (по умолчанию llama-3.3-70b-versatile).
GROQ_MODEL=
# Для картинок (по умолчанию llama-3.2-90b-vision-preview).
GROQ_VISION_MODEL=
# Адрес API (по умолчанию https://api.groq.com/openai/v1)
GROQ_BASE_URL=
